APP_ENV=development

# Local LLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Leave blank to force runtime discovery of an installed Qwen 3 8B candidate.
OLLAMA_MODEL=

# Data
DATA_DIR=./data
ARTIFACT_DIR=./artifacts

# RAG (Phase 5)
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_PATH=./artifacts/vector_store

# API
API_HOST=127.0.0.1
API_PORT=8000
